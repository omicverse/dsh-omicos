{
  "name": "@omicverse/dsh-omicos",
  "version": "0.3.0",
  "description": "OmicOS OSS scientific workbench for DeepSeek Harness, with persistent local execution and optional official cloud services",
  "type": "module",
  "main": "./lib/host/index.js",
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./scientist": "./lib/host/scientist.js",
    "./scientist/locale/*.json": "./locale/*.json",
    "./scientist/icon": "./icon.svg"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "runtime",
    "OMICOS_OSS_DESIGN.md",
    "locale",
    "icon.svg",
    "esbuild.*.mjs",
    "scripts",
    "test",
    "tsconfig*.json",
    "LEGACY_CORE.md",
    "IMPLEMENTATION_STATUS.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.host.mjs && node esbuild.client.mjs && rm -f lib/client.cjs.tmp",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "start:oss": "node lib/oss/cli.js",
    "test:browser": "pnpm build && node scripts/browser-smoke.cjs",
    "test:package": "pnpm build && node scripts/clean-install-smoke.mjs",
    "test:provisioning": "pnpm build && node scripts/provision-orphan-smoke.cjs",
    "test:provisioning:online": "pnpm build && node scripts/provision-pypi-smoke.cjs --online",
    "test:harness-browser": "pnpm build && node scripts/harness-browser-smoke.cjs",
    "start:app": "node scripts/launch-application.cjs",
    "start:preview": "node scripts/launch-harness-preview.cjs",
    "start:desktop-preview": "node scripts/launch-desktop-preview.cjs",
    "test:desktop-application": "node scripts/desktop-application-smoke.cjs",
    "test:application-browser": "node scripts/harness-application-smoke.cjs",
    "test:application-preferences": "pnpm build && node scripts/application-preferences-smoke.cjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "proper-lockfile": "4.1.2",
    "qrcode": "1.5.4",
    "tar": "7.5.22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.3",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "dsh-better-sidebar": "^0.28.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    },
    "dsh-better-sidebar": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  },
