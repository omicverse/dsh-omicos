    "dsh-better-sidebar": "0.28.0",
    "esbuild": "0.24.2",
    "playwright": "1.62.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.3.0",
    "vitest": "^2.1.8"
  },
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/omicverse/dsh-omicos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omicverse/dsh-omicos.git"
  },
  "bugs": {
