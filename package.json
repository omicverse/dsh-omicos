{
  "name": "@omicverse/dsh-omicos",
  "version": "0.2.0",
  "description": "OmicOS as a deepseek-harness (dsh) plugin — Mode A: omicos bioinformatics tools + background jobs + login commands for the dsh agent (DSH-PLUGIN.md).",
  "type": "module",
  "main": "./lib/host/index.js",
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.host.mjs && node esbuild.client.mjs && rm -f lib/client.cjs.tmp",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "@omicverse/omicos": "^0.3.30"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "dsh-better-sidebar": "^0.12.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    },
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@omicverse/omicos-client": "^0.1.1",
    "@omicverse/omicos-launcher": "^0.1.1",
    "@omicverse/omicos-protocol": "^0.1.1",
    "@types/node": "^22.0.0",
    "@types/react": "18.3.12",
    "dsh-better-sidebar": "0.12.2",
    "esbuild": "0.24.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.3.0",
    "vitest": "^2.1.8"
  },
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/omicverse/dsh-omicos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omicverse/dsh-omicos.git"
  },
  "bugs": {
    "url": "https://github.com/omicverse/dsh-omicos/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "omicos",
    "omicverse",
    "bioinformatics",
    "single-cell",
    "spatial-transcriptomics"
  ]
}
